---
import "../styles/global.css";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Nacer Para Vivir" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />

		<!-- Seguridad: anti-clickjacking, anti-sniffing, referrer -->
		<meta http-equiv="X-Frame-Options" content="DENY" />
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<!-- CSP: solo permite recursos del mismo origen + fonts de Google + la API -->
		<meta http-equiv="Content-Security-Policy" content="
			default-src 'self';
			script-src 'self' 'unsafe-inline';
			style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
			font-src 'self' https://fonts.gstatic.com;
			img-src 'self' data: https:;
			connect-src 'self' http://fnpvi.nacerparavivir.org;
			frame-src https://drive.google.com;
			object-src 'none';
			base-uri 'self';
		" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Roboto:wght@300;400;500;700;900&display=swap"
			rel="stylesheet"
		/>

		<!-- Material Symbols -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
		/>
	</head>
	<body class="selection:bg-[#69ff87] selection:text-[#002108]">
		<slot />
		<ChatWidget />
	</body>
</html>

<style is:global>
	.material-symbols-outlined {
		font-variation-settings:
			"FILL" 0,
			"wght" 400,
			"GRAD" 0,
			"opsz" 24;
		display: inline-block;
		vertical-align: middle;
	}
</style>
