---
// Video principal destacado
const mainVideo = {
  id: 'ym9PMujeFIU',
  url: 'https://youtu.be/ym9PMujeFIU?si=vhkol1OPFWnnHDSB'
};

// Lista de 6 videos adicionales
const videos = [
  { id: 'IMufsC1V0ow', url: 'https://youtu.be/IMufsC1V0ow?si=t5JH2uc3crmrt9Fz' },
  { id: '_HDuM7GQp1Q', url: 'https://youtu.be/_HDuM7GQp1Q?si=DovYVxpdFBvDvBAN' },
  { id: 'HiQwgwTGSYI', url: 'https://youtu.be/HiQwgwTGSYI?si=KZXqhZNbNrtR3bcf' },
  { id: 'EPeHFoeBKsc', url: 'https://youtu.be/EPeHFoeBKsc?si=IKyfDUpMRqUgUy5-' },
  { id: 'ZYQuJG-NR_g', url: 'https://youtu.be/ZYQuJG-NR_g?si=4V7b_72kvo2Ffq0C' },
  { id: 'WBx1XAw8Cj4', url: 'https://youtu.be/WBx1XAw8Cj4?si=ylC7nAK4gASEzCfw' }
];
---

<section class="novedades-section" id="novedades">
  <div class="container">
    <div class="section-header">
      <h2 class="title">NOVEDADES</h2>
      <p class="subtitle">Mira nuestros últimos contenidos y actualizaciones</p>
    </div>

    <div class="novedades-grid">
      <!-- Video Principal -->
      <div class="video-principal-wrapper">
        <div class="video-principal-container">
          <iframe
            id="main-video-iframe"
            width="100%"
            height="100%"
            src={`https://www.youtube.com/embed/${mainVideo.id}`}
            title="Video Principal Nacer para Vivir"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowFullScreen
          ></iframe>
        </div>
      </div>

      <!-- Videos Miniatura Grid -->
      <div class="videos-grid">
        {videos.map((video) => (
          <button
            class="video-card"
            data-video-id={video.id}
            title="Reproducir video"
            type="button"
            aria-label={`Reproducir video ${video.id}`}
          >
            <div class="video-thumbnail">
              <img
                src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`}
                alt="Video thumbnail"
                loading="lazy"
              />
              <div class="video-overlay">
                <span class="material-symbols-outlined play-icon">play_circle</span>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Blobs decorativos -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const videoCards = document.querySelectorAll('.video-card');
    const mainIframe = document.getElementById('main-video-iframe');

    // Marcar el primer video como activo por defecto
    if (videoCards.length > 0) {
      videoCards[0].classList.add('active');
    }

    videoCards.forEach((card) => {
      card.addEventListener('click', () => {
        const videoId = card.getAttribute('data-video-id');

        if (videoId) {
          // Actualizar src del iframe con autoplay
          mainIframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;

          // Remover clase active de todos los cards
          videoCards.forEach((c) => c.classList.remove('active'));

          // Agregar clase active al card clickeado
          card.classList.add('active');

          // Scroll smooth al video principal
          mainIframe.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

<style>
  .novedades-section {
    background-color: var(--color-surface-container-low);
    padding: 4rem 0;
    position: relative;
    overflow: hidden;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-brand-dark);
  }

  .subtitle {
    color: var(--color-primary);
    max-width: 40rem;
    margin: 0 auto;
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  /* Grid principal: 2 columnas en desktop */
  .novedades-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* Video Principal Responsivo */
  .video-principal-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .video-principal-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 12px 24px -5px rgba(0, 0, 0, 0.12);
    transition: all 0.3s ease;
  }

  .video-principal-container:hover {
    box-shadow: 0 20px 35px -5px rgba(0, 0, 0, 0.15);
    transform: translateY(-4px);
  }

  .video-principal-container iframe {
    border: none;
    border-radius: 1.5rem;
  }

  /* Grid de videos miniatura: 3 columnas */
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-content: start;
  }

  /* Card individual de video */
  .video-card {
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    background: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    cursor: pointer;
    border: 3px solid transparent;
    padding: 0;
    width: 100%;
    text-align: left;
  }

  .video-card:hover {
    box-shadow: 0 15px 25px -5px rgba(0, 0, 0, 0.15);
    transform: translateY(-4px);
  }

  /* Estado activo: video seleccionado */
  .video-card.active {
    border: 3px solid var(--color-primary);
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.3);
  }

  .video-card.active:hover {
    box-shadow: 0 15px 40px rgba(37, 211, 102, 0.4);
  }

  .video-thumbnail {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .video-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .video-card:hover .video-thumbnail img {
    transform: scale(1.05);
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .video-card:hover .video-overlay {
    background: rgba(0, 0, 0, 0.5);
  }

  .play-icon {
    font-size: 3rem;
    color: white;
    opacity: 0.9;
    transition: all 0.3s ease;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .video-card:hover .play-icon {
    opacity: 1;
    transform: scale(1.1);
  }

  /* Blobs decorativos */
  .blob {
    position: absolute;
    border-radius: 50%;
    opacity: 0.1;
    z-index: 0;
    pointer-events: none;
  }

  .blob-1 {
    width: 300px;
    height: 300px;
    background: #25D366; /* Color primario verde */
    top: -50px;
    right: -100px;
  }

  .blob-2 {
    width: 250px;
    height: 250px;
    background: #0a1f0f; /* Color brand dark */
    bottom: 50px;
    left: -80px;
  }

  /* Responsivo: Tablet (768px - 1023px) */
  @media (max-width: 1023px) {
    .novedades-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .videos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .title {
      font-size: 2rem;
    }
  }

  /* Responsivo: Móvil (< 768px) */
  @media (max-width: 767px) {
    .novedades-section {
      padding: 2.5rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .title {
      font-size: 1.8rem;
      margin-bottom: 0.75rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .novedades-grid {
      gap: 1.5rem;
    }

    .videos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .video-card {
      border-radius: 0.75rem;
    }

    .play-icon {
      font-size: 2rem;
    }

    /* Ajustar blobs para móvil */
    .blob-1 {
      width: 200px;
      height: 200px;
    }

    .blob-2 {
      width: 150px;
      height: 150px;
    }
  }

  /* Pequeños ajustes para pantallas muy grandes (> 1440px) */
  @media (min-width: 1441px) {
    .title {
      font-size: 3rem;
    }

    .videos-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
