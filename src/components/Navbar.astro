      <a class="nav-link nav-public" href="/#contacts">Contactos</a>
      <a class="nav-link nav-public" href="/publico">Públicos</a>
      <a class="nav-link nav-public" href="/#novedades">Novedades</a>
      <a class="nav-link nav-auth-link" href="/personal" id="nav-acceso">Acceso Personal</a>

      <div class="social-icons">
