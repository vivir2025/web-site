    <nav class="mobile-menu" id="mobile-menu">
      <a href="/" class="mobile-nav-link nav-public">Inicio</a>
      <a href="/#contacts" class="mobile-nav-link nav-public">Contactos</a>
      <a href="/publico" class="mobile-nav-link nav-public">Públicos</a>
      <a href="/#novedades" class="mobile-nav-link nav-public">Novedades</a>
      <a href="/personal" class="mobile-nav-link nav-auth-link" id="mobile-nav-acceso">Acceso Personal</a>

      <div class="mobile-social-icons">
        <a href="https://www.facebook.com/share/18Xk1gfugG/" target="_blank" rel="noopener noreferrer" class="mobile-social-icon" aria-label="Facebook">
