<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    // — Mobile toggle —
    if (toggle && mobileMenu) {
      toggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('open');
        toggle.classList.toggle('active');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
          toggle.classList.remove('active');
        });
      });
    }

    // — Bloqueo de nav según sesión —
    const isLoggedIn = !!localStorage.getItem('fnpv_token');

    const publicLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-public');
    const authLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-auth-link');

    if (isLoggedIn) {
      // Bloquear links públicos
      publicLinks.forEach(link => {
        link.classList.add('nav-blocked');
        link.addEventListener('click', e => e.preventDefault());
        link.setAttribute('aria-disabled', 'true');
        link.setAttribute('tabindex', '-1');
      });

      // Cambiar "Acceso Personal" por "Documentos Internos"
      authLinks.forEach(link => {
        link.textContent = 'Documentos Internos';
        link.setAttribute('href', '/documentos-internos');
      });
    }
  });
</script>

<style>
  .navbar {
    position: absolute;
    top: 1.5rem;
    left: 0;
    width: 100%;
    z-index: 100;
    background: transparent;
  }

  .navbar.dark {
    position: sticky;
    top: 0;
    background: linear-gradient(to right,
      #1a4428 0%,
      #2e8a4e 50%,
      #39d36b 100%
    );
    padding: 1rem 0;
  }

  .logo {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-img {
    height: 100px; /* Ajustá esto para que no sea muy grande */
    width: auto;
  }

  .text-white { color: #fff; }
  .text-dark { color: #000; }

  .nav-links {
    display: flex;
    gap: 3rem;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-headline);
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: #ca8a04;
    transform: translateY(-1px);
  }

  .nav-link.nav-blocked,
  .mobile-nav-link.nav-blocked {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  .nav-link.nav-blocked:hover,
  .mobile-nav-link.nav-blocked:hover {
    color: #fff;
    transform: none;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #ca8a04;
    transition: width 0.3s ease;
  }


  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
    background: #ca8a04;
  }

  .social-icons {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-left: 1rem;
    padding-left: 2rem;
    border-left: 1px solid rgba(255,255,255,0.2);
  }

  .social-icon {
    color: #fff;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }

  .social-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .social-icon:hover {
    color: #ca8a04;
    transform: translateY(-2px);
  }

  .btn-primary {
    background: #000;
    color: #fff;
    padding: 0.85rem 1.75rem;
    border-radius: 0.75rem;
    font-family: var(--font-headline);
    font-weight: 800;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  }

  .px-inset {
    padding-left: 4rem;
    padding-right: 4rem;
  }

  /* Mobile Menu Toggle Button */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 101;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle .menu-icon {
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
  }

  .mobile-menu-toggle:hover .menu-icon {
    color: #ca8a04;
    transform: scale(1.1);
  }

  /* Mobile Menu */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 100px;
    left: 0;
    right: 0;
    background: transparent;
    padding: 2rem;
    max-height: 0;
    overflow: hidden;
    flex-direction: column;
    gap: 1rem;
    transition: max-height 0.3s ease;
    z-index: 100;
  }

  /* Mobile menu with dark mode (other pages) */
  .navbar.dark .mobile-menu {
    background: linear-gradient(to right,
      #1a4428 0%,
      #2e8a4e 50%,
      #39d36b 100%
    );
  }

  .mobile-menu.open {
    max-height: 600px;
  }

  .mobile-nav-link {
    color: #fff;
    font-family: var(--font-headline);
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
    display: block;
    padding: 0.75rem;
    padding-bottom: 0.5rem;
    transition: all 0.3s ease;
    border-radius: 0.5rem;
    position: relative;
    border-bottom: 2px solid rgba(202, 138, 4, 0.2);
  }

  .mobile-nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #ca8a04;
    transition: width 0.3s ease;
  }

  .mobile-nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ca8a04;
    padding-left: 1.25rem;
    border-bottom-color: #ca8a04;
  }

  .mobile-nav-link:hover::after {
    width: 100%;
  }

  .mobile-social-icons {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    justify-content: center;
  }

  .mobile-social-icon {
    color: #fff;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }

  .mobile-social-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .mobile-social-icon:hover {
    color: #ca8a04;
    transform: translateY(-2px);
  }

  /* Desktop Styles */
  @media (min-width: 1025px) {
    .mobile-menu-toggle {
      display: none !important;
    }

    .mobile-menu {
      display: none !important;
    }

    .nav-links {
      display: flex;
    }
  }

  /* Tablet and Mobile Styles */
  @media (max-width: 1024px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .mobile-menu {
      display: flex;
    }

    .px-inset {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .logo-img {
      height: 80px;
    }
  }

  @media (max-width: 640px) {
    .px-inset {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .logo-img {
      height: 60px;
    }

    .mobile-menu {
      top: 80px;
      padding: 1.5rem;
    }

    .mobile-menu-toggle .menu-icon {
      font-size: 1.5rem;
    }
  }
</style>