---
// PublicDocuments Component - Sistema de pestañas interactivo para documentos públicos
---

<section class="public-documents-section">
	<div class="container">
		<div class="section-header">
			<h2 class="title">Documentos Públicos</h2>
			<p class="subtitle">
				La Fundación Nacer para Vivir pone a disposición de la ciudadanía la nueva sección de
				transparencia y acceso, la información pública de la IPS. Según lo dicta la ley.
			</p>
		</div>

		<!-- Tabs Navigation -->
		<div class="tabs-container">
			<button class="tab-button active" data-tab="informacion">
				<span class="material-symbols-outlined">info</span>
				Información de la entidad
			</button>
			<button class="tab-button" data-tab="normativa">
				<span class="material-symbols-outlined">description</span>
				Normativa de la entidad
			</button>
			<button class="tab-button" data-tab="alertas">
				<span class="material-symbols-outlined">warning</span>
				Alertas INVIMA
			</button>
		</div>

		<!-- Tab Content -->
		<div class="tabs-content">
			<!-- TAB 1: INFORMACIÓN DE LA ENTIDAD -->
			<div class="tab-panel active" id="informacion">
				<div class="documents-grid">
					<!-- Carpeta: RUT -->
					<div class="folder-card">
						<div class="folder-header">
							<span class="material-symbols-outlined folder-icon">folder_open</span>
							<h3>Registro Único Tributario (RUT)</h3>
						</div>
						<div class="documents-list">
							<a
								href="https://ejemplo.com/rut.pdf"
								target="_blank"
								rel="noopener noreferrer"
								class="document-link"
							>
								<span class="material-symbols-outlined doc-icon">description</span>
								<span class="doc-name">rut.pdf</span>
								<span class="material-symbols-outlined download-icon">file_download</span>
							</a>
						</div>
					</div>

					<!-- Carpeta: Estatutos Sociales -->
					<div class="folder-card">
						<div class="folder-header">
							<span class="material-symbols-outlined folder-icon">folder_open</span>
							<h3>Estatutos Sociales</h3>
						</div>
						<div class="documents-list">
							<a
								href="https://ejemplo.com/estatutos.pdf"
								target="_blank"
								rel="noopener noreferrer"
								class="document-link"
							>
								<span class="material-symbols-outlined doc-icon">description</span>
								<span class="doc-name">estatutos.pdf</span>
								<span class="material-symbols-outlined download-icon">file_download</span>
							</a>
						</div>
					</div>

					<!-- Carpeta: Certificado de Existencia -->
					<div class="folder-card">
						<div class="folder-header">
							<span class="material-symbols-outlined folder-icon">folder_open</span>
							<h3>Certificado de Existencia</h3>
						</div>
						<div class="documents-list">
							<a
								href="https://ejemplo.com/certificado.pdf"
								target="_blank"
								rel="noopener noreferrer"
								class="document-link"
							>
								<span class="material-symbols-outlined doc-icon">description</span>
								<span class="doc-name">certificado.pdf</span>
								<span class="material-symbols-outlined download-icon">file_download</span>
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- TAB 2: NORMATIVA DE LA ENTIDAD -->
			<div class="tab-panel" id="normativa">
				<div class="documents-grid">
					<!-- Carpeta: Resoluciones -->
					<div class="folder-card">
						<div class="folder-header">
							<span class="material-symbols-outlined folder-icon">folder_open</span>
							<h3>Resoluciones</h3>
						</div>
						<div class="documents-list">
							<a
								href="https://ejemplo.com/resolucion.pdf"
								target="_blank"
								rel="noopener noreferrer"
								class="document-link"
							>
								<span class="material-symbols-outlined doc-icon">description</span>
								<span class="doc-name">resolucion-001.pdf</span>
								<span class="material-symbols-outlined download-icon">file_download</span>
							</a>
						</div>
					</div>

					<!-- Carpeta: Políticas Internas -->
					<div class="folder-card">
						<div class="folder-header">
							<span class="material-symbols-outlined folder-icon">folder_open</span>
							<h3>Políticas Internas</h3>
						</div>
						<div class="documents-list">
							<a
								href="https://ejemplo.com/politicas.pdf"
								target="_blank"
								rel="noopener noreferrer"
								class="document-link"
							>
								<span class="material-symbols-outlined doc-icon">description</span>
								<span class="doc-name">politicas.pdf</span>
								<span class="material-symbols-outlined download-icon">file_download</span>
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- TAB 3: ALERTAS INVIMA -->
			<div class="tab-panel" id="alertas">
				<div class="documents-grid">
					<!-- Carpeta: Alertas Sanitarias 2024 -->
					<div class="folder-card">
						<div class="folder-header">
							<span class="material-symbols-outlined folder-icon">folder_open</span>
							<h3>Alertas Sanitarias 2024</h3>
						</div>
						<div class="documents-list">
							<a
								href="https://ejemplo.com/alerta.pdf"
								target="_blank"
								rel="noopener noreferrer"
								class="document-link"
							>
								<span class="material-symbols-outlined doc-icon">description</span>
								<span class="doc-name">alerta-001.pdf</span>
								<span class="material-symbols-outlined download-icon">file_download</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Blobs decorativos (fondo) -->
	<div class="blob blob-1"></div>
	<div class="blob blob-2"></div>
</section>

<style>
	.public-documents-section {
		background-color: var(--color-surface);
		padding: 4rem 0;
		position: relative;
		overflow: hidden;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.title {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		color: var(--color-brand-dark);
	}

	.section-header .subtitle {
		color: var(--color-primary);
		max-width: 50rem;
		margin: 0 auto;
		font-weight: 400;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	/* Tabs Navigation */
	.tabs-container {
		display: flex;
		gap: 1rem;
		margin-bottom: 3rem;
		border-bottom: 2px solid var(--color-surface-container-low);
		overflow-x: auto;
		padding-bottom: 1rem;
	}

	.tab-button {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.8rem 1.5rem;
		background: none;
		border: none;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		position: relative;
		transition: all 0.3s ease;
		white-space: nowrap;
		font-family: var(--font-headline);
		text-transform: uppercase;
		letter-spacing: -0.01em;
	}

	.tab-button .material-symbols-outlined {
		font-size: 1.3rem;
	}

	.tab-button:hover {
		color: var(--color-brand-dark);
		transform: translateY(-2px);
	}

	.tab-button.active {
		color: var(--color-brand-dark);
	}

	.tab-button.active::after {
		content: '';
		position: absolute;
		bottom: -1rem;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-brand-dark));
		border-radius: 2px;
	}

	/* Tab Content */
	.tabs-content {
		position: relative;
	}

	.tab-panel {
		display: none;
		animation: fadeIn 0.3s ease;
	}

	.tab-panel.active {
		display: block;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Documents Grid */
	.documents-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
	}

	/* Folder Card */
	.folder-card {
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		border-radius: 2.5rem;
		padding: 2rem;
		transition: all 0.3s ease;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
	}

	.folder-card:hover {
		box-shadow: 0 15px 20px -5px rgba(0, 110, 42, 0.1);
		transform: translateY(-4px);
		border-color: rgba(37, 211, 102, 0.3);
	}

	.folder-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.folder-icon {
		font-size: 2rem;
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.folder-header h3 {
		font-size: 1.15rem;
		color: var(--color-brand-dark);
		margin: 0;
		line-height: 1.3;
	}

	/* Documents List */
	.documents-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.document-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		background: var(--color-surface-container-low);
		border-radius: 0.75rem;
		text-decoration: none;
		color: var(--color-brand-dark);
		transition: all 0.3s ease;
		border: 1px solid transparent;
	}

	.document-link:hover {
		background: var(--color-primary);
		color: white;
		border-color: var(--color-primary);
		transform: translateX(4px);
	}

	.doc-icon {
		font-size: 1.3rem;
		flex-shrink: 0;
	}

	.doc-name {
		flex: 1;
		font-weight: 500;
		font-size: 0.95rem;
		text-decoration: underline;
		text-decoration-color: currentColor;
		text-underline-offset: 3px;
	}

	.download-icon {
		font-size: 1.1rem;
		opacity: 0;
		transition: opacity 0.3s ease;
		flex-shrink: 0;
	}

	.document-link:hover .download-icon {
		opacity: 1;
	}

	/* Blobs decorativos */
	.blob {
		position: absolute;
		border-radius: 50%;
		opacity: 0.15;
		z-index: 0;
		pointer-events: none;
	}

	.blob-1 {
		width: 300px;
		height: 300px;
		background: var(--color-primary);
		top: -50px;
		right: -100px;
	}

	.blob-2 {
		width: 250px;
		height: 250px;
		background: var(--color-brand-dark);
		bottom: -80px;
		left: -100px;
	}

	/* Responsividad */
	@media (max-width: 1024px) {
		.documents-grid {
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 1.5rem;
		}

		.title {
			font-size: 2rem;
		}
	}

	@media (max-width: 768px) {
		.public-documents-section {
			padding: 2rem 0;
		}

		.section-header {
			margin-bottom: 2.5rem;
		}

		.title {
			font-size: 1.75rem;
		}

		.section-header .subtitle {
			font-size: 0.95rem;
		}

		.tabs-container {
			flex-direction: column;
			gap: 0;
			border-bottom: none;
			padding-bottom: 0;
		}

		.tab-button {
			width: 100%;
			justify-content: flex-start;
			padding: 1rem;
			border-left: 3px solid transparent;
			border-bottom: none;
		}

		.tab-button.active {
			background: var(--color-surface-container-low);
			border-left-color: var(--color-primary);
		}

		.tab-button.active::after {
			display: none;
		}

		.documents-grid {
			grid-template-columns: 1fr;
		}

		.folder-card {
			padding: 1.5rem;
		}

		.folder-header h3 {
			font-size: 1rem;
		}
	}
</style>

<script>
	// Manejo de pestañas interactivas
	const tabButtons = document.querySelectorAll('.tab-button');
	const tabPanels = document.querySelectorAll('.tab-panel');

	tabButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const tabId = button.getAttribute('data-tab');

			// Remover clase activa de todos los botones y paneles
			tabButtons.forEach((btn) => btn.classList.remove('active'));
			tabPanels.forEach((panel) => panel.classList.remove('active'));

			// Añadir clase activa al botón y panel seleccionados
			button.classList.add('active');
			const panel = document.getElementById(tabId);
			if (panel) {
				panel.classList.add('active');
			}
		});
	});
</script>
