<style>
	.public-documents-section {
		background-color: var(--color-surface);
		padding: 4rem 0;
		position: relative;
		overflow: hidden;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.title {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		color: var(--color-brand-dark);
	}

	.section-header .subtitle {
		color: var(--color-primary);
		max-width: 50rem;
		margin: 0 auto;
		font-weight: 400;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	/* Documents Grid */
	.documents-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
	}

	/* Folder Accordion */
	.folder-accordion {
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		border-radius: 2.5rem;
		padding: 2rem;
		transition: all 0.3s ease;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
		list-style: none;
	}

	.folder-accordion:hover {
		box-shadow: 0 15px 20px -5px rgba(0, 110, 42, 0.1);
		transform: translateY(-4px);
		border-color: rgba(37, 211, 102, 0.3);
	}

	.folder-summary {
		display: flex;
		align-items: center;
		gap: 1rem;
		cursor: pointer;
		transition: all 0.3s ease;
		list-style: none;
		user-select: none;
	}

	.folder-summary::-webkit-details-marker {
		display: none;
	}

	.folder-icon {
		font-size: 2rem;
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.folder-summary h3 {
		font-size: 1.15rem;
		color: var(--color-brand-dark);
		margin: 0;
		line-height: 1.3;
		flex: 1;
	}

	.folder-summary .expand-icon {
		font-size: 1.5rem;
		color: var(--color-primary);
		transition: transform 0.3s ease;
		flex-shrink: 0;
	}

	.folder-accordion[open] .folder-summary .expand-icon {
		transform: rotate(180deg);
	}

	/* Documents List */
	.documents-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 1.5rem;
		padding-left: 0;
	}

	/* Document Accordion */
	.document-accordion {
		list-style: none;
	}

	.document-summary {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		background: var(--color-surface-container-low);
		border-radius: 0.75rem;
		cursor: pointer;
		transition: all 0.3s ease;
		border: 1px solid transparent;
		user-select: none;
		list-style: none;
	}

	.document-summary::-webkit-details-marker {
		display: none;
	}

	.document-summary:hover {
		background: var(--color-primary);
		color: white;
		border-color: var(--color-primary);
	}

	.document-summary .material-symbols-outlined {
		font-size: 1.3rem;
		flex-shrink: 0;
	}

	.document-summary span:nth-child(2) {
		flex: 1;
		font-weight: 500;
		font-size: 0.95rem;
		text-decoration: underline;
		text-decoration-color: currentColor;
		text-underline-offset: 3px;
		color: inherit;
	}

	.document-summary .expand-icon {
		transition: transform 0.3s ease;
		flex-shrink: 0;
	}

	.document-accordion[open] .document-summary .expand-icon {
		transform: rotate(180deg);
	}

	.document-accordion[open] .document-summary {
		background: var(--color-primary);
		color: white;
	}

	/* Document Link */
	.document-link {
		display: none;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		background: var(--color-surface-container-low);
		border-radius: 0.75rem;
		text-decoration: none;
		color: var(--color-brand-dark);
		transition: all 0.3s ease;
		border: 1px solid transparent;
		margin-left: 2.3rem;
		margin-top: 0.5rem;
	}

	.document-link:hover {
		background: var(--color-primary);
		color: white;
		border-color: var(--color-primary);
		transform: translateX(4px);
	}

	.document-accordion[open] > .document-link {
		display: flex;
	}

	.document-link .material-symbols-outlined {
		font-size: 1.1rem;
		flex-shrink: 0;
	}

	/* Empty Folder Message */
	.empty-folder {
		text-align: center;
		color: var(--color-primary);
		font-size: 0.95rem;
		padding: 1.5rem 1rem;
		margin: 0;
		font-style: italic;
		background: var(--color-surface-container-low);
		border-radius: 0.75rem;
	}

	/* Blobs decorativos */
	.blob {
		position: absolute;
		border-radius: 50%;
		opacity: 0.15;
		z-index: 0;
		pointer-events: none;
	}

	.blob-1 {
		width: 300px;
		height: 300px;
		background: var(--color-primary);
		top: -50px;
		right: -100px;
	}

	.blob-2 {
		width: 250px;
		height: 250px;
		background: var(--color-brand-dark);
		bottom: -80px;
		left: -100px;
	}

	/* Responsividad */
	@media (max-width: 1024px) {
		.documents-grid {
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 1.5rem;
		}

		.title {
			font-size: 2rem;
		}
	}

	@media (max-width: 768px) {
		.public-documents-section {
			padding: 2rem 0;
		}

		.section-header {
			margin-bottom: 2.5rem;
		}

		.title {
			font-size: 1.75rem;
		}

		.section-header .subtitle {
			font-size: 0.95rem;
		}

		.documents-grid {
			grid-template-columns: 1fr;
		}

		.folder-accordion {
			padding: 1.5rem;
		}

		.folder-summary h3 {
			font-size: 1rem;
		}

		.document-summary {
			flex-wrap: wrap;
		}

		.document-summary span:nth-child(2) {
			flex-basis: 100%;
		}

		.document-link {
			margin-left: 0.75rem;
		}
	}
</style>

