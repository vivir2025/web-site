---
import { Image } from 'astro:assets';
import foto1 from '../assets/cajibio.jpg';
import foto2 from '../assets/programa.jpg';
import foto3 from '../assets/circulo.jpg';
import cariImg from '../assets/cari.png';

const slides = [
	{ id: 1, label: 'Municipio de Cajibío', image: foto1 },
	{ id: 2, label: 'Programa de Riesgo Cardiovascular', image: foto2 },
	{ id: 3, label: 'Personal de la fundación', image: foto3 },
];
---
<section class="hero-section">
	<!-- Triángulo superpuesto en la parte inferior -->
	<div class="triangle-overlay"></div>
	
	<div class="container">
		<div class="grid-layout items-center">
			<div class="hero-content">
			<h4 class="hero-title">
				FUNDACIÓN <br/>
				<span class="text-bold-white">NACER PARA VIVIR</span> <br/>
				<span id="typewriter" class="typewriter-text"></span><span class="cursor">|</span>
			</h4>
			<p class="hero-description mb-12">
				Organización comunitaria llegando a tu vida.
			</p>
			
			<div class="button-group-wrapper mt-8">
				<div class="flex-row gap-4 flex-wrap">
					<a href="/ecosistema-digital" class="btn-lg btn-light">Ecosistema Digital</a>
					<button class="btn-lg btn-brand">Escribenos</button>
					<a href="https://fnpvi.nacerparavivir.org/docs" target="_blank" class="btn-lg btn-accent">Documentación</a>
				</div>
			</div>

			<p class="hero-description text-justify">
				Somos una Fundación creada por líderes comunitarios preocupados por mejorar la salud de la población, basada en un modelo de atención diferencial, realizando acciones encaminadas a disminuir la morbilidad y la mortalidad.
			</p>
		</div>
		
		<div class="hero-visual">
			<div class="code-window">
				<div class="window-header">
					<div class="dots">
						<span class="dot red"></span>
						<span class="dot yellow"></span>
						<span class="dot green"></span>
					</div>
					<div class="tab" id="carousel-tab">Municipio de Cajibío</div>
				</div>
				
				<div class="carousel-container" id="carousel-trigger">
					<div class="carousel-track" id="carousel-track">
						{slides.map(slide => (
							<div class="slide">
								{slide.image ? (
									<Image src={slide.image} alt={slide.label} class="carousel-img" width={1000} height={600} format="webp" quality="mid" />
								) : (
									<div class="placeholder-slide">{slide.label}</div>
								)}
							</div>
						))}
					</div>
				</div>
			</div>
			
			<div class="floating-asset">
				<Image src={cariImg} alt="Cari" class="cari-img" width={450} format="webp" quality="mid" />
			</div>
		</div>
		</div>
	</div>
</section>

<style>
	.hero-section {
		background: linear-gradient(135deg,
			#0a1f0f 0%,
			#0f2e18 20%,
			#1a4428 40%,
			#2e8a4e 65%,
			#39d36b 100%
		);
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding-top: 9rem;
		position: relative;
		overflow: hidden;
	}

	.triangle-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 400px; /* Un poco más alto para impacto */
		background: linear-gradient(to right, 
			#39d36b 0%,      /* Verde claro a la izquierda */
			#2e8a4e 50%,     /* Verde medio */
			#1a4428 100%     /* Verde oscuro a la derecha */
		);
		clip-path: polygon(0 90%, 100% 0, 100% 100%, 0 100%);
		z-index: 1;
		opacity: 0.9;
	}

	.grid-layout {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 4rem;
		position: relative;
		z-index: 2;
		width: 100%;
	}

	.items-center { align-items: center; }

	@media (max-width: 1024px) {
		.grid-layout {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.flex-row { justify-content: center; }
	}

	.badge {
		background: #000;
		color: #fff;
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 800;
		margin-bottom: 2rem;
		display: inline-block;
	}

	.hero-title {
		font-size: 3.2rem;
		line-height: 1.1;
		color: #fff;
		margin-bottom: 1.5rem;
		margin-left: 0;
		padding-left: 0;
		letter-spacing: -0.02em;
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
	}

	@media (max-width: 768px) {
		.hero-title { font-size: 2.8rem; }
	}

	.text-bold-white {
		color: #fff;
		font-weight: 900;
	}

	.text-highlight {
		color: #fff;
		-webkit-text-stroke: 1px #000;
		text-shadow: 4px 4px 0px #000;
	}

	.typewriter-text {
		font-size: 2rem;
		color: #fff;
		font-weight: 700;
		text-transform: uppercase;
	}

	.cursor {
		font-size: 2rem;
		color: var(--color-primary);
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		from, to { opacity: 1; }
		50% { opacity: 0; }
	}

	.hero-description {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.59);
		max-width: 32rem;
		font-weight: 500;
	}

	.button-group-wrapper {
		width: fit-content;
		position: relative;
		padding-bottom: 1.5rem;
		margin-bottom: 2rem;
	}

	.button-group-wrapper::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: linear-gradient(to right, #fff 0%, #0a1f0f 50%, #000 100%);
	}

	.text-justify {
		text-align: justify;
	}

	.mb-12 { margin-bottom: 1.5rem; }

	.btn-lg {
		padding: 0.8rem 1.8rem;
		border-radius: 0.75rem;
		font-family: var(--font-headline);
		font-weight: 800;
		font-size: 1.125rem;
		cursor: pointer;
		border: none;
		transition: all 0.3s ease;
	}

	.btn-light {
		background: #fff;
		color: #0a1f0f;
	}

	.btn-light:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.15);
	}

	.btn-dark {
		background: #000;
		color: #fff;
	}

	.btn-dark:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.15);
	}

	.btn-brand {
		background: #2e8a4e;
		color: #fff;
		border: none;
	}

	.btn-brand:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.15);
		background: #257a44;
	}

	.btn-accent {
		background: #ca8a04;
		color: #fff;
		border: none;
	}

	.btn-accent:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.15);
		background: #b47b04;
	}

	.flex-wrap { flex-wrap: wrap; }

	/* Responsive flex row for button groups */
	.flex-row {
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: flex-start;
	}

	/* Desktop - buttons horizontal */
	@media (min-width: 1025px) {
		.flex-row {
			flex-direction: row;
			gap: 1rem;
		}

		.btn-lg {
			padding: 0.85rem 1.75rem;
			font-size: 1rem;
			white-space: nowrap;
		}
	}

	/* Tablet - stack buttons vertically */
	@media (max-width: 1024px) {
		.flex-row {
			flex-direction: column;
			gap: 0.75rem;
			justify-content: center;
		}

		.btn-lg {
			width: 100%;
			padding: 0.75rem 1.5rem;
			font-size: 0.95rem;
		}
	}

	/* Mobile - stack buttons vertically with smaller padding */
	@media (max-width: 768px) {
		.flex-row {
			flex-direction: column;
			gap: 0.5rem;
			justify-content: center;
		}

		.btn-lg {
			width: 100%;
			padding: 0.7rem 1.25rem;
			font-size: 0.9rem;
		}
	}

	.btn-outline {
		background: transparent;
		color: #000;
		border: 2.5px solid #000;
	}

	.btn-outline:hover {
		background: rgba(0,0,0,0.05);
	}

	.hero-visual {
		position: relative;
	}

	.floating-asset {
		position: absolute;
		bottom: -3rem;
		right: -2rem;
		z-index: 20;
		filter: drop-shadow(0 20px 40px rgba(0,0,0,0.2));
		animation: float 6s ease-in-out infinite;
	}

	.cari-img {
		height: 180px;
		width: auto;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-20px); }
	}

	.code-window {
		background: #0D0F12;
		border-radius: 1.25rem;
		overflow: hidden;
		box-shadow: 0 40px 80px rgba(0,0,0,0.3);
		border: 1px solid rgba(255,255,255,0.1);
	}

	.window-header {
		background: #1A1D24;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.dots { display: flex; gap: 0.5rem; }
	.dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; }
	.red { background: #ff5f56; }
	.yellow { background: #ffbd2e; }
	.green { background: #27c93f; }

	.tab { font-family: var(--font-label); font-size: 0.75rem; color: #8b949e; }

	.carousel-container {
		width: 100%;
		height: 400px;
		overflow: hidden;
		background: #000;
		position: relative;
	}

	.carousel-track {
		display: flex;
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		height: 100%;
	}

	.slide {
		min-width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-headline);
		font-weight: 800;
		color: #555;
	}

	.carousel-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder-slide {
		background: #1A1D24;
		border: 2px dashed #333;
		width: 100%;
		height: 100%;
	}

	.method { color: #3E3CFF; font-weight: bold; }
	.key { color: var(--color-primary); }

	.status-overlay {
		background: var(--color-primary);
		color: #000;
		padding: 0.75rem 1.5rem;
		font-family: var(--font-label);
		font-weight: 800;
		font-size: 0.875rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border-radius: 0.75rem;
		width: fit-content;
		margin: 0 2rem 2rem;
		position: absolute;
		bottom: 0;
		left: 0;
		z-index: 10;
	}
</style>

<script>
	const slides = [
		{ label: 'Municipio de Cajibío' },
		{ label: 'Programa de Riesgo Cardiovascular' },
		{ label: 'Personal de la Facturación' }
	];

	let currentIndex = 0;
	const track = document.getElementById('carousel-track');
	const tab = document.getElementById('carousel-tab');
	const trigger = document.getElementById('carousel-trigger');

	function nextSlide() {
		currentIndex = (currentIndex + 1) % slides.length;
		if (track && tab) {
			track.style.transform = `translateX(-${currentIndex * 100}%)`;
			tab.textContent = slides[currentIndex].label;
		}
	}

	// Avance manual al hacer click
	if (trigger) {
		trigger.addEventListener('click', nextSlide);
		trigger.style.cursor = 'pointer';
	}

	// Avance automático más lento (5 segundos)
	setInterval(nextSlide, 5000);

	// Lógica Efecto Máquina de Escribir
	const typewriterElement = document.getElementById('typewriter');
	const services = [
		'Medicina general',
		'Medicina interna',
		'Enfermeria',
		'Nefrologia',
		'Nutricion',
		'Imagenes diagnosticas',
		'Ecocardiograma',
		'Toma de muestras',
		'Laboratorio clinico'
	];

	let serviceIndex = 0;
	let charIndex = 0;
	let isDeleting = false;
	let delay = 150;

	function type() {
		if (!typewriterElement) return;

		const currentService = services[serviceIndex];
		
		if (isDeleting) {
			typewriterElement.textContent = currentService.substring(0, charIndex);
			charIndex--;
			delay = 50;
		} else {
			typewriterElement.textContent = currentService.substring(0, charIndex + 1);
			charIndex++;
			delay = 150;
		}

		if (!isDeleting && charIndex === currentService.length) {
			isDeleting = true;
			delay = 2000; // Pausa al terminar de escribir
		} else if (isDeleting && charIndex === 0) {
			isDeleting = false;
			serviceIndex = (serviceIndex + 1) % services.length;
			delay = 500;
		}

		setTimeout(type, delay);
	}

	if (typewriterElement) {
		type();
	}
</script>
