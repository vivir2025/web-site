---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Acceso Personal - Nacer Para Vivir">
  <Navbar dark />
  <main class="login-page">
    <div class="login-wrapper">
      <div class="login-card">

        <div class="login-header">
          <div class="shield-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 10c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.249-8.25-3.286z" />
            </svg>
          </div>
          <h1 class="login-title">Acceso Personal</h1>
          <p class="login-subtitle">Ingresá tus credenciales para acceder al portal interno</p>
        </div>

        <form class="login-form" id="login-form" novalidate>
          <div class="field-group">
            <label class="field-label" for="usuario">Usuario</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                </svg>
              </span>
              <input
                type="text"
                id="usuario"
                name="usuario"
                class="field-input"
                placeholder="Tu usuario"
                autocomplete="username"
                required
              />
            </div>
          </div>

          <div class="field-group">
            <label class="field-label" for="contrasena">Contraseña</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                </svg>
              </span>
              <input
                type="password"
                id="contrasena"
                name="contrasena"
                class="field-input"
                placeholder="Tu contraseña"
                autocomplete="current-password"
                required
              />
              <button type="button" class="toggle-password" id="toggle-password" aria-label="Mostrar contraseña">
                <svg class="eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <svg class="eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="error-msg" id="error-msg" role="alert" aria-live="polite"></div>

          <button type="submit" class="btn-login" id="btn-login">
            <span class="btn-text">Ingresar</span>
            <span class="btn-spinner" style="display:none">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spinner-svg">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/>
              </svg>
              Verificando...
            </span>
          </button>
        </form>

      </div>

      <div class="login-decoration" aria-hidden="true">
        <div class="deco-circle deco-1"></div>
        <div class="deco-circle deco-2"></div>
        <div class="deco-circle deco-3"></div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_BASE;
  const MAX_INTENTOS = 3;
  const BLOQUEO_MS = 15 * 60 * 1000; // 15 minutos
  const KEY_INTENTOS = 'fnpv_intentos';
  const KEY_BLOQUEO = 'fnpv_bloqueo_hasta';

  // Si ya tiene sesión, redirigir directo
  if (localStorage.getItem('fnpv_token')) {
    window.location.href = '/documentos-internos';
  }

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const btnLogin = document.getElementById('btn-login') as HTMLButtonElement;
  const btnText = btnLogin.querySelector('.btn-text') as HTMLSpanElement;
  const btnSpinner = btnLogin.querySelector('.btn-spinner') as HTMLSpanElement;
  const togglePassword = document.getElementById('toggle-password') as HTMLButtonElement;
  const passwordInput = document.getElementById('contrasena') as HTMLInputElement;
  const usuarioInput = document.getElementById('usuario') as HTMLInputElement;
  const eyeShow = togglePassword.querySelector('.eye-show') as SVGElement;
  const eyeHide = togglePassword.querySelector('.eye-hide') as SVGElement;

  let countdownInterval: ReturnType<typeof setInterval> | null = null;

  // — Helpers de rate limiting —
  function getIntentos(): number {
    return parseInt(localStorage.getItem(KEY_INTENTOS) || '0', 10);
  }

  function getBloqueoHasta(): number {
    return parseInt(localStorage.getItem(KEY_BLOQUEO) || '0', 10);
  }

  function estaBlockeado(): boolean {
    const hasta = getBloqueoHasta();
    if (hasta && Date.now() < hasta) return true;
    // Si el bloqueo ya expiró, limpiar
    if (hasta && Date.now() >= hasta) {
      localStorage.removeItem(KEY_INTENTOS);
      localStorage.removeItem(KEY_BLOQUEO);
    }
    return false;
  }

  function registrarIntentoFallido() {
    const intentos = getIntentos() + 1;
    localStorage.setItem(KEY_INTENTOS, String(intentos));
    if (intentos >= MAX_INTENTOS) {
      localStorage.setItem(KEY_BLOQUEO, String(Date.now() + BLOQUEO_MS));
    }
    return intentos;
  }

  function bloquearFormulario() {
    usuarioInput.disabled = true;
    passwordInput.disabled = true;
    togglePassword.disabled = true;
    btnLogin.disabled = true;
    form.classList.add('form-blocked');
    iniciarCountdown();
  }

  function desbloquearFormulario() {
    usuarioInput.disabled = false;
    passwordInput.disabled = false;
    togglePassword.disabled = false;
    btnLogin.disabled = false;
    form.classList.remove('form-blocked');
    errorMsg.classList.remove('visible', 'error-block');
    errorMsg.textContent = '';
    if (countdownInterval) clearInterval(countdownInterval);
  }

  function iniciarCountdown() {
    if (countdownInterval) clearInterval(countdownInterval);
    countdownInterval = setInterval(() => {
      const hasta = getBloqueoHasta();
      const restante = hasta - Date.now();
      if (restante <= 0) {
        clearInterval(countdownInterval!);
        desbloquearFormulario();
        return;
      }
      const mins = Math.floor(restante / 60000);
      const segs = Math.floor((restante % 60000) / 1000);
      const tiempoStr = mins > 0
        ? `${mins}m ${String(segs).padStart(2, '0')}s`
        : `${segs}s`;
      showError(`Demasiados intentos fallidos. Podés intentarlo nuevamente en ${tiempoStr}.`, true);
    }, 1000);
  }

  // Verificar estado de bloqueo al cargar
  if (estaBlockeado()) {
    bloquearFormulario();
  }

  // — Toggle contraseña —
  togglePassword.addEventListener('click', () => {
    const isHidden = passwordInput.type === 'password';
    passwordInput.type = isHidden ? 'text' : 'password';
    eyeShow.style.display = isHidden ? 'none' : '';
    eyeHide.style.display = isHidden ? '' : 'none';
  });

  // — Submit —
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (estaBlockeado()) {
      bloquearFormulario();
      return;
    }

    errorMsg.classList.remove('visible', 'error-block');
    errorMsg.textContent = '';

    const usuario = usuarioInput.value.trim();
    const contrasena = passwordInput.value;

    if (!usuario || !contrasena) {
      showError('Completá todos los campos.');
      return;
    }

    setLoading(true);

    try {
      const res = await fetch(`${API_BASE}/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ usuario, contrasena }),
      });

      const data = await res.json();

      if (!res.ok || data.error) {
        const intentos = registrarIntentoFallido();

        if (intentos >= MAX_INTENTOS) {
          bloquearFormulario();
        } else {
          const restantes = MAX_INTENTOS - intentos;
          showError(
            `Credenciales incorrectas. Te ${restantes === 1 ? 'queda' : 'quedan'} ${restantes} intento${restantes === 1 ? '' : 's'}.`
          );
        }
        return;
      }

      // Login exitoso — limpiar contadores
      localStorage.removeItem(KEY_INTENTOS);
      localStorage.removeItem(KEY_BLOQUEO);

      localStorage.setItem('fnpv_token', data.token || data.access_token || 'authenticated');

      const userObj = data.user || data.data || data;
      const rawNombre =
        userObj?.nombre || userObj?.name || userObj?.usuario ||
        data.nombre || data.name || data.usuario || usuario;
      const nombreFinal = typeof rawNombre === 'object'
        ? (rawNombre?.nombre || rawNombre?.name || rawNombre?.usuario || usuario)
        : String(rawNombre ?? usuario);
      localStorage.setItem('fnpv_nombre', nombreFinal);

      window.location.href = '/documentos-internos';

    } catch {
      showError('No se pudo conectar al servidor. Verificá tu conexión.');
    } finally {
      setLoading(false);
    }
  });

  function showError(msg: string, isBlock = false) {
    errorMsg.textContent = msg;
    errorMsg.classList.add('visible');
    if (isBlock) errorMsg.classList.add('error-block');
    else errorMsg.classList.remove('error-block');
  }

  function setLoading(loading: boolean) {
    btnLogin.disabled = loading || estaBlockeado();
    btnText.style.display = loading ? 'none' : '';
    btnSpinner.style.display = loading ? '' : 'none';
  }
</script>

<style>
  .login-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0a1f0f 0%, #1a4428 50%, #0a1f0f 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  .login-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 460px;
  }

  .login-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.5rem;
    padding: 2.5rem;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
  }

  .login-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .shield-icon {
    width: 4rem;
    height: 4rem;
    background: linear-gradient(135deg, #25D366, #1a4428);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
  }

  .shield-icon svg {
    width: 2rem;
    height: 2rem;
    color: #fff;
  }

  .login-title {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .login-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    font-family: var(--font-body);
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-family: var(--font-headline);
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.875rem;
    color: rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .input-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .field-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.75rem;
    padding: 0.85rem 3rem 0.85rem 2.75rem;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: all 0.3s ease;
    outline: none;
  }

  .field-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .field-input:focus {
    border-color: #25D366;
    background: rgba(37, 211, 102, 0.08);
    box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.15);
  }

  .toggle-password {
    position: absolute;
    right: 0.875rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    padding: 0.25rem;
    transition: color 0.2s ease;
  }

  .toggle-password:hover {
    color: #25D366;
  }

  .toggle-password svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .error-msg {
    display: none;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    color: #fca5a5;
    font-size: 0.875rem;
    font-family: var(--font-body);
  }

  .error-msg.visible {
    display: block;
  }

  .btn-login {
    width: 100%;
    background: linear-gradient(135deg, #25D366 0%, #1ea952 100%);
    color: #fff;
    border: none;
    border-radius: 0.875rem;
    padding: 0.95rem;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .btn-login:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(37, 211, 102, 0.35);
  }

  .btn-login:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .btn-spinner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .spinner-svg {
    width: 1.1rem;
    height: 1.1rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Decorative circles */
  .login-decoration {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .deco-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.15;
  }

  .deco-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #25D366, transparent);
    top: -100px;
    right: -100px;
  }

  .deco-2 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, #1a4428, transparent);
    bottom: -50px;
    left: -50px;
  }

  .deco-3 {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, #FF9A00, transparent);
    bottom: 30%;
    right: 10%;
    opacity: 0.08;
  }

  /* Estado bloqueado */
  .form-blocked .field-input {
    opacity: 0.45;
    cursor: not-allowed;
    background: rgba(239, 68, 68, 0.05);
    border-color: rgba(239, 68, 68, 0.25);
  }

  .form-blocked .btn-login {
    background: linear-gradient(135deg, #6b7280, #4b5563);
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .error-msg.error-block {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.45);
    color: #fca5a5;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .login-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
