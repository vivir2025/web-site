---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Documentos Internos - Nacer Para Vivir">
  <Navbar dark />
  <main class="docs-page" id="docs-page" style="display:none">

    <!-- Welcome bar -->
    <div class="welcome-bar">
      <div class="container flex justify-between items-center">
        <div class="welcome-text">
          <span class="welcome-greeting">Bienvenido/a,</span>
          <strong class="welcome-name" id="welcome-name">—</strong>
        </div>
        <button class="btn-logout" id="btn-logout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"/>
          </svg>
          Cerrar sesión
        </button>
      </div>
    </div>

    <!-- Page header -->
    <section class="docs-header">
      <div class="container">
        <div class="header-badge">Portal Interno</div>
        <h1 class="header-title">Documentos Internos</h1>
        <p class="header-desc">Accedé a los documentos y comunicados oficiales de la Fundación Nacer Para Vivir.</p>
      </div>
    </section>

    <!-- Documents section -->
    <section class="docs-section">
      <div class="container">

        <div class="section-block">
          <div class="section-title-row">
            <div class="section-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/>
              </svg>
            </div>
            <h2 class="section-title">Reglamento Interno</h2>
          </div>

          <div class="folders-grid">

            <!-- Carpeta 1: Comunicado Interno Socialización -->
            <a
              href="#"
              id="folder-comunicado"
              class="folder-card"
              target="_blank"
              rel="noopener noreferrer"
              data-url-key="comunicado"
            >
              <div class="folder-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.5 21a3 3 0 003-3v-4.5a3 3 0 00-3-3h-15a3 3 0 00-3 3V18a3 3 0 003 3h15zM1.5 10.146V6a3 3 0 013-3h5.379a2.25 2.25 0 011.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 013 3v1.146A4.483 4.483 0 0019.5 9h-15a4.483 4.483 0 00-3 1.146z"/>
                </svg>
              </div>
              <div class="folder-info">
                <span class="folder-name">Comunicado Interno Socialización</span>
                <span class="folder-meta">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                  </svg>
                  Abrir documento
                </span>
              </div>
            </a>

            <!-- Carpeta 2: Reglamento Interno de Trabajo -->
            <a
              href="#"
              id="folder-reglamento"
              class="folder-card"
              target="_blank"
              rel="noopener noreferrer"
              data-url-key="reglamento"
            >
              <div class="folder-icon folder-icon--accent">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.5 21a3 3 0 003-3v-4.5a3 3 0 00-3-3h-15a3 3 0 00-3 3V18a3 3 0 003 3h15zM1.5 10.146V6a3 3 0 013-3h5.379a2.25 2.25 0 011.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 013 3v1.146A4.483 4.483 0 0019.5 9h-15a4.483 4.483 0 00-3 1.146z"/>
                </svg>
              </div>
              <div class="folder-info">
                <span class="folder-name">Reglamento Interno de Trabajo</span>
                <span class="folder-meta">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                  </svg>
                  Abrir documento
                </span>
              </div>
            </a>

            <!-- Carpeta 3: Protocolos y procedimientos institucionales -->
            <a
              href="#"
              id="folder-protocolos"
              class="folder-card"
              target="_blank"
              rel="noopener noreferrer"
              data-url-key="protocolos"
            >
              <div class="folder-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.5 21a3 3 0 003-3v-4.5a3 3 0 00-3-3h-15a3 3 0 00-3 3V18a3 3 0 003 3h15zM1.5 10.146V6a3 3 0 013-3h5.379a2.25 2.25 0 011.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 013 3v1.146A4.483 4.483 0 0019.5 9h-15a4.483 4.483 0 00-3 1.146z"/>
                </svg>
              </div>
              <div class="folder-info">
                <span class="folder-name">Protocolos y procedimientos institucionales</span>
                <span class="folder-meta">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                  </svg>
                  Abrir documento
                </span>
              </div>
            </a>

          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- Spinner mientras verifica auth -->
  <div class="auth-loading" id="auth-loading">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="auth-spinner">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/>
    </svg>
  </div>

  <Footer />
</BaseLayout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_BASE;

  const DOC_URLS: Record<string, string> = {
    comunicado: 'https://drive.google.com/file/d/1UfdaXPnI-3KUECAe0Atw64yRc762xwil/preview',
    reglamento: 'https://drive.google.com/file/d/15Xny8B_Fp7_Frha3kkZeESpOgheNY6kq/preview',
    protocolos: 'https://nacerparavivir-my.sharepoint.com/:f:/g/personal/rips_nacerparavivir_onmicrosoft_com/IgBCWWGgNvpVTY33cgrrekISAX0KsiZKePaW_n9VCoS-Yh8?e=ADqQK9',
  };

  const docsPage = document.getElementById('docs-page') as HTMLElement;
  const authLoading = document.getElementById('auth-loading') as HTMLElement;
  const welcomeName = document.getElementById('welcome-name') as HTMLElement;
  const btnLogout = document.getElementById('btn-logout') as HTMLButtonElement;

  // Verificar autenticación
  const token = localStorage.getItem('fnpv_token');
  const nombre = localStorage.getItem('fnpv_nombre');

  if (!token) {
    window.location.href = '/personal';
  } else {
    authLoading.style.display = 'none';
    docsPage.style.display = '';
    welcomeName.textContent = nombre || 'Personal';

    // Asignar URLs a las carpetas
    const folderComunicado = document.getElementById('folder-comunicado') as HTMLAnchorElement;
    const folderReglamento = document.getElementById('folder-reglamento') as HTMLAnchorElement;
    const folderProtocolos = document.getElementById('folder-protocolos') as HTMLAnchorElement;

    folderComunicado.href = DOC_URLS.comunicado;
    folderReglamento.href = DOC_URLS.reglamento;
    folderProtocolos.href = DOC_URLS.protocolos;
  }

  // Cerrar sesión
  btnLogout.addEventListener('click', async () => {
    btnLogout.disabled = true;
    btnLogout.textContent = 'Cerrando...';

    try {
      await fetch(`${API_BASE}/logout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      });
    } catch {
      // Si falla el logout en el servidor igual limpiamos local
    } finally {
      localStorage.removeItem('fnpv_token');
      localStorage.removeItem('fnpv_nombre');
      window.location.href = '/personal';
    }
  });
</script>

<style>
  .auth-loading {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0a1f0f, #1a4428);
  }

  .auth-spinner {
    width: 3rem;
    height: 3rem;
    color: #25D366;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Welcome Bar */
  .welcome-bar {
    background: linear-gradient(to right, #1a4428, #2e8a4e, #39d36b);
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .welcome-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .welcome-greeting {
    opacity: 0.8;
  }

  .welcome-name {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 1rem;
  }

  .btn-logout {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 0.625rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-logout:hover {
    background: rgba(239, 68, 68, 0.25);
    border-color: rgba(239, 68, 68, 0.5);
  }

  .btn-logout svg {
    width: 1rem;
    height: 1rem;
  }

  /* Page Header */
  .docs-header {
    background: linear-gradient(135deg, #0a1f0f 0%, #1a4428 100%);
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .header-badge {
    display: inline-block;
    background: rgba(37, 211, 102, 0.15);
    border: 1px solid rgba(37, 211, 102, 0.3);
    color: #25D366;
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.35rem 1rem;
    border-radius: 2rem;
    margin-bottom: 1rem;
  }

  .header-title {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .header-desc {
    color: rgba(255,255,255,0.65);
    font-family: var(--font-body);
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* Documents Section */
  .docs-section {
    background: #f8faf8;
    padding: 3rem 0 5rem;
    min-height: 50vh;
  }

  .section-block {
    background: #fff;
    border-radius: 1.25rem;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.06);
  }

  .section-title-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid #f0f0f0;
  }

  .section-icon {
    width: 2.5rem;
    height: 2.5rem;
    background: linear-gradient(135deg, #25D366, #1ea952);
    border-radius: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .section-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #fff;
  }

  .section-title {
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 800;
    color: #0a1f0f;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  /* Folders Grid */
  .folders-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .folder-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #f8faf8;
    border: 1.5px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .folder-card:hover {
    border-color: #25D366;
    background: #f0fdf4;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.15);
  }

  .folder-icon {
    width: 3rem;
    height: 3rem;
    background: linear-gradient(135deg, #25D366, #1ea952);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .folder-icon--accent {
    background: linear-gradient(135deg, #FF9A00, #e08500);
  }

  .folder-icon svg {
    width: 1.4rem;
    height: 1.4rem;
    color: #fff;
  }

  .folder-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .folder-name {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.95rem;
    color: #111827;
    line-height: 1.3;
  }

  .folder-meta {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: #6b7280;
    transition: color 0.2s ease;
  }

  .folder-meta svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .folder-card:hover .folder-meta {
    color: #25D366;
  }

  @media (max-width: 640px) {
    .docs-section {
      padding: 2rem 0 3rem;
    }

    .section-block {
      padding: 1.5rem 1rem;
    }

    .folders-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
