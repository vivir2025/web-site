---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import borniveIcon from '../assets/borniveicoo.png';
---

<BaseLayout title="Bornive - Ecosistema Digital" description="Bornive: Administrador de historial clínico para IPS">
	<Navbar dark={true} />

	<main class="main-content">
		<!-- Hero Section -->
		<section class="hero-section">
			<div class="container">
				<div class="hero-content">
					<div class="hero-text">
						<h1 class="hero-title">Bornive</h1>
						<p class="hero-description">
							Un administrador para la gestión del historial clínico de nuestros pacientes, solo accesible para el personal de la IPS.
						</p>
						<p class="hero-version">Versión 2.0.0</p>
					</div>
					<div class="hero-image-placeholder">
						<Image src={borniveIcon} alt="Bornive Logo" class="bornive-logo" width={200} format="webp" quality="mid" />
					</div>
				</div>
			</div>
			<div class="blob blob-1"></div>
			<div class="blob blob-2"></div>
		</section>

		<!-- Sections Navigation -->
		<section class="sections-section">
			<div class="container">
				<div class="tabs-container">
					<button class="tab-button active" data-tab="descargas">
						<span class="material-symbols-outlined">download</span>
						Descargas
					</button>
					<button class="tab-button" data-tab="documentacion">
						<span class="material-symbols-outlined">description</span>
						Documentación
					</button>
					<button class="tab-button" data-tab="privacidad">
						<span class="material-symbols-outlined">shield</span>
						Política de Privacidad
					</button>
					<button class="tab-button" data-tab="tutorial">
						<span class="material-symbols-outlined">play_circle</span>
						Tutorial
					</button>
				</div>

				<!-- Tab Contents -->
				<div class="tabs-content">
					<!-- DESCARGAS -->
					<div class="tab-panel active" id="descargas">
						<div class="downloads-grid">
							<!-- Windows Card -->
							<div class="platform-card">
								<div class="platform-header">
									<span class="material-symbols-outlined platform-icon">computer</span>
									<h3>Windows</h3>
								</div>
								<div class="platform-content">
									<div class="installer-type">
										<h4>User Installer</h4>
										<div class="download-links">
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>x64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>Arm64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
										</div>
									</div>
									<div class="installer-type">
										<h4>System Installer</h4>
										<div class="download-links">
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>x64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>Arm64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
										</div>
									</div>
								</div>
							</div>

							<!-- Mac Card -->
							<div class="platform-card">
								<div class="platform-header">
									<span class="material-symbols-outlined platform-icon">apple</span>
									<h3>macOS</h3>
								</div>
								<div class="platform-content">
									<div class="installer-type">
										<h4>Universal Installer</h4>
										<div class="download-links">
											<span class="download-link-pending">
												<span>.dmg Universal</span>
												<span style="opacity: 0.5;">Pendiente</span>
											</span>
										</div>
									</div>
								</div>
							</div>

							<!-- Android Card -->
							<div class="platform-card">
								<div class="platform-header">
									<span class="material-symbols-outlined platform-icon">android</span>
									<h3>Android</h3>
								</div>
								<div class="platform-content">
									<div class="installer-type">
										<h4>Google Play Store</h4>
										<div class="download-links">
											<a href="https://play.google.com/store/apps/details?id=com.fnpv.sistema&pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>Android 10+</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- DOCUMENTACIÓN -->
					<div class="tab-panel" id="documentacion">
						<div class="documentation-grid">
							<div class="doc-card">
								<div class="doc-header">
									<span class="material-symbols-outlined doc-icon">description</span>
									<h3>Guía de Instalación</h3>
								</div>
								<p class="doc-description">Instrucciones detalladas para instalar Bornive en tu dispositivo.</p>
								<button type="button" class="doc-link doc-restricted">
									Leer documentación
									<span class="material-symbols-outlined">arrow_forward</span>
								</button>
							</div>

							<div class="doc-card">
								<div class="doc-header">
									<span class="material-symbols-outlined doc-icon">settings</span>
									<h3>Configuración</h3>
								</div>
								<p class="doc-description">Aprende a configurar Bornive para tu entorno.</p>
								<button type="button" class="doc-link doc-restricted">
									Leer documentación
									<span class="material-symbols-outlined">arrow_forward</span>
								</button>
							</div>

							<div class="doc-card">
								<div class="doc-header">
									<span class="material-symbols-outlined doc-icon">support_agent</span>
									<h3>Manual de Usuario</h3>
								</div>
								<p class="doc-description">Guía completa de uso de la aplicación.</p>
								<button type="button" class="doc-link doc-restricted">
									Leer documentación
									<span class="material-symbols-outlined">arrow_forward</span>
								</button>
							</div>
						</div>
					</div>

					<!-- POLÍTICA DE PRIVACIDAD -->
					<div class="tab-panel" id="privacidad">
						<section class="privacy-policy-section">
							<h2>POLÍTICA DE PRIVACIDAD Y PROTECCIÓN DE DATOS PERSONALES</h2>
							<h3>APLICACIÓN MÓVIL BORNIVE</h3>
							<p class="subtitle">Fundación Nacer Para Vivir IPS</p>
							<p class="subtitle-small">Resolución 1995 de 2020 – y Decreto 1377 de 2013</p>
							<p class="vigencia"><strong>Vigencia: 12 de May de 2026</strong></p>

							<h2>1. PRESENTACIÓN E IDENTIFICACIÓN DEL RESPONSABLE</h2>
							<p>
								La Fundación Nacer Para Vivir IPS (en adelante "la Fundación"), identificada con NIT 900817959, domiciliada en CALLE 5 # REAL # 4-35 Sede Principal Municipio de cajibío, representa el compromiso de proteger la privacidad y los datos personales de los pacientes y usuarios de la aplicación móvil BORNIVE.
							</p>
							<p>
								En cumplimiento de la Ley 1581 de 2012, el Decreto 1377 de 2013, la Resolución 1995 de 2020 del Ministerio de Salud, y demás normatividad vigente en Colombia sobre protección de datos personales y datos de salud, presentamos esta Política de Privacidad que rige el tratamiento de datos en la aplicación BORNIVE.
							</p>

							<h3>1.1 Responsable del Tratamiento de Datos</h3>
							<ul>
								<li><strong>Nombre:</strong> Fundación Nacer Para Vivir IPS</li>
								<li><strong>Tipo de Institución:</strong> Institución Prestadora de Servicios de Salud (IPS)</li>
								<li><strong>NIT:</strong> 90081759</li>
								<li><strong>Correo de Atención General:</strong> tecnologia@nacerparavivir.org</li>
								<li><strong>Teléfono:</strong> 3235414793</li>
							</ul>

							<h2>2. OBJETO Y PRINCIPIOS</h2>

							<h3>2.1 Objeto</h3>
							<p>
								El objeto de esta Política es informar al usuario de manera clara, transparente y comprensible sobre cómo la Fundación Nacer Para Vivir IPS recopila, utiliza, almacena, transfiere y protege los datos personales y datos de salud en el desarrollo, operación y mejora de la aplicación BORNIVE.
							</p>

							<h3>2.2 Principios</h3>
							<ul>
								<li><strong>Licitud:</strong> El tratamiento de datos se realiza conforme a la ley y normativa vigente en Colombia.</li>
								<li><strong>Veracidad:</strong> Los datos recopilados deben ser exactos, completos y actualizados.</li>
								<li><strong>Transparencia:</strong> Se informa al titular de forma clara sobre el tratamiento de sus datos.</li>
								<li><strong>Accesibilidad:</strong> El titular puede acceder y conocer sus datos en cualquier momento.</li>
								<li><strong>Seguridad:</strong> Implementamos medidas técnicas y administrativas para proteger los datos.</li>
								<li><strong>Confidencialidad:</strong> Los datos se tratan en forma confidencial y no serán divulgados sin su consentimiento.</li>
							</ul>

							<h2>3. DEFINICIONES</h2>
							<ul>
								<li><strong>Dato Personal:</strong> Cualquier información vinculada o que pueda asociarse a una persona natural identificada o identificable.</li>
								<li><strong>Datos de Salud:</strong> Información relativa a la salud física o mental de una persona, datos genéticos, antecedentes médicos, diagnósticos, medicamentos, alergias y cualquier información clínica.</li>
								<li><strong>Tratamiento:</strong> Cualquier operación realizada sobre datos personales, como recopilación, almacenamiento, uso, transferencia, supresión o destrucción.</li>
								<li><strong>Titular:</strong> Persona natural a quien se refieren los datos personales tratados o recaudados.</li>
								<li><strong>Encargado del Tratamiento:</strong> Persona que recauda y almacena datos personales por cuenta del responsable, conforme a instrucciones de este.</li>
								<li><strong>Consentimiento:</strong> Manifestación de voluntad libre, específica, informada e inequívoca por la cual el titular acepta el tratamiento de sus datos.</li>
							</ul>

							<h2>4. DATOS PERSONALES Y DE SALUD RECOPILADOS</h2>
							<p>
								La aplicación BORNIVE recopila los siguientes datos personales y datos de salud de los pacientes con el propósito de proporcionar servicios de seguimiento clínico:
							</p>
							<ul>
								<li><strong>Identificación:</strong> Nombre completo, número de cédula, teléfono, correo electrónico y dirección de residencia.</li>
								<li><strong>Geolocalización:</strong> Coordenadas GPS de ubicación del paciente para seguimiento clínico y visitas domiciliarias</li>
								<li><strong>Información Clínica:</strong> Diagnósticos, historial médico y/o comorbilidades (diabetes, hipertensión, etc.)</li>
								<li><strong>Medicamentos:</strong> Medicamentos prescritos, dosis, frecuencia, medicamentos pendientes, adherencia al tratamiento</li>
								<li><strong>Visitas Domiciliarias:</strong> Fechas, horarios, resultados de visitas en el domicilio del paciente</li>
								<li><strong>Datos de Contacto:</strong> Teléfono, correo, dirección, contacto de emergencia</li>
								<li><strong>Información de Sesión:</strong> Fecha y hora de acceso, acciones realizadas en la aplicación, dispositivo usado</li>
							</ul>
							<p>
								La recopilación de estos datos es obligatoria para la prestación del servicio de seguimiento clínico. El paciente que no proporcione esta información no podrá utilizar la aplicación.
							</p>

							<h2>5. PROPÓSITO DEL TRATAMIENTO</h2>
							<p>
								Los datos personales y datos de salud recopilados a través de BORNIVE se utilizan para los siguientes propósitos:
							</p>
							<ul>
								<li><strong>Seguimiento clínico de pacientes:</strong> Monitoreo de la condición médica, evolución clínica y adherencia al tratamiento.</li>
								<li><strong>Geolocalización:</strong> Identificación de la ubicación del paciente para coordinar visitas domiciliarias, atención en emergencias y optimizar rutas de atención en campo.</li>
								<li><strong>Registro de medicamentos:</strong> Control de medicamentos prescritos, dosis, adherencia y medicamentos pendientes.</li>
								<li><strong>Estadísticas clínicas:</strong> Identificación de patrones de enfermedad (diabetes, comorbilidades, etc.) para mejorar programas de salud pública.</li>
								<li><strong>Registro clínico electrónico:</strong> Mantenimiento de historias clínicas electrónicas de conformidad con normatividad vigente</li>
								<li><strong>Mejora de servicios:</strong> Análisis de uso de la plataforma para optimizar funcionalidad y experiencia del usuario.</li>
								<li><strong>Cumplimiento normativo:</strong> Cumplimiento con regulaciones sanitarias y de protección de datos en Colombia.</li>
							</ul>

							<h2>6. BASE LEGAL PARA EL TRATAMIENTO</h2>
							<p>
								El tratamiento de datos personales y datos de salud en BORNIVE se fundamenta en:
							</p>
							<ul>
								<li><strong>Consentimiento Informado del Paciente:</strong> Previo al uso de la aplicación, el paciente otorga consentimiento libre e informado para el tratamiento de sus datos.</li>
								<li><strong>Interés Legítimo en Salud:</strong> Como institución prestadora de servicios de salud, tenemos un interés legítimo en proteger la salud del paciente.</li>
								<li><strong>Obligaciones Legales:</strong> La Ley 1438 de 2011 y normas del Ministerio de Salud exigen mantener registros de atención clínica.</li>
								<li><strong>Cumplimiento de Obligaciones Contractuales:</strong> El tratamiento es necesario para cumplir con la relación médico-paciente.</li>
								<li><strong>Normativa de Protección de Datos:</strong> Resolución 1995 de 2020, Ley 1581 de 2012 y Decreto Reglamentario 1377 de 2013.</li>
							</ul>

							<h2>7. COMPARTICIÓN DE DATOS</h2>
							<p>
								<strong>Política de Confidencialidad:</strong> La Fundación Nacer Para Vivir IPS NO comparte los datos personales o datos de salud del paciente con terceros, proveedores externos, plataformas de analítica, o empresas de publicidad. Los datos permanecen bajo el control y custodia exclusiva de la Fundación.
							</p>

							<h3>Excepciones: Los datos podrán ser compartidos únicamente en los siguientes casos:</h3>
							<ul>
								<li>Por orden judicial, administrativa o de autoridad competente.</li>
								<li>Con el consentimiento explícito del paciente.</li>
								<li>Con autoridades sanitarias en caso de situación de emergencia o salud pública.</li>
								<li>La Entidad Administradora de Planes de Beneficios – EAPB del paciente.</li>
								<li>Con auditorías internas para fines de cumplimiento normativo y control de calidad</li>
							</ul>

							<h2>8. ALMACENAMIENTO Y SEGURIDAD DE DATOS</h2>

							<h3>8.1 Ubicación de Servidores</h3>
							<p>
								Los datos se almacenan en servidores localizados en Colombia, conforme a regulaciones locales de protección de datos y normativa del Ministerio de Tecnologías de la Información.
							</p>

							<h3>8.2 Medidas Técnicas de Seguridad</h3>
							<ul>
								<li><strong>Encriptación:</strong> Datos en tránsito encriptados con TLS 1.2 o superior; datos en reposo con encriptación AES-256.</li>
								<li><strong>Autenticación:</strong> Acceso mediante credenciales seguras, autenticación de dos factores.</li>
								<li><strong>Firewalls y detección:</strong> Firewalls, sistemas de detección de intrusiones (IDS) y prevención de amenazas.</li>
								<li><strong>Backup y recuperación:</strong> Copias de seguridad regulares con planes de recuperación ante desastres.</li>
								<li><strong>Actualizaciones:</strong> Parches de seguridad y actualizaciones de software periódicas.</li>
							</ul>

							<h3>8.3 Medidas Administrativas y Organizacionales</h3>
							<ul>
								<li><strong>Acceso restringido:</strong> Solo personal autorizado de la Fundación accede a datos con contratos.</li>
								<li><strong>Capacitación:</strong> Personal capacitado en protección de datos y privacidad.</li>
								<li><strong>Auditorías:</strong> Auditorías internas periódicas de cumplimiento normativo.</li>
								<li><strong>Políticas de privacidad:</strong> Políticas documentadas de privacidad y seguridad de información.</li>
							</ul>

							<h2>9. DERECHOS DEL PACIENTE (DERECHOS ARCO)</h2>
							<p>
								Conforme a la Ley 1581 de 2012 y Decreto 1377 de 2013, el paciente/titular de datos tiene derecho a:
							</p>
							<ul>
								<li><strong>Acceso:</strong> Conocer qué datos personales tiene la Fundación sobre usted, para qué se usan y a quién se comunican.</li>
								<li><strong>Rectificación:</strong> Solicitar corrección de datos inexactos, incompletos o desactualizados.</li>
								<li><strong>Cancelación/Supresión:</strong> Solicitar la supresión de datos cuando cese la relación con la Fundación, con excepciones legales.</li>
								<li><strong>Oposición:</strong> Oponerse al tratamiento de sus datos para propósitos específicos.</li>
								<li><strong>Revocación del consentimiento:</strong> Retirar el consentimiento otorgado, sin retroactividad.</li>
							</ul>

							<h2>10. CÓMO EJERCER SUS DERECHOS</h2>
							<p>
								Para ejercer cualquiera de los derechos ARCO, el paciente debe enviar una solicitud escrita a:
							</p>
							<ul class="no-bullet">
								<li><strong>Correo electrónico:</strong> tecnologia@nacerparavivir.org</li>
								<li><strong>Dirección física:</strong> [COMPLETAR DIRECCIÓN]</li>
								<li><strong>Teléfono:</strong> [COMPLETAR TELÉFONO]</li>
							</ul>

							<h3>Requisitos de la solicitud:</h3>
							<ul>
								<li>Identificación completa (nombre, cédula, teléfono y correo electrónico).</li>
								<li>Descripción clara de la solicitud y datos a los cuales se refiere.</li>
								<li>Copia de documento de identificación.</li>
							</ul>

							<h3>Plazo de respuesta:</h3>
							<p>
								La Fundación responderá la solicitud en un plazo máximo de 15 días hábiles de acuerdo a lo descrito en la ley 1755 de 2015.
							</p>

							<h3>Costo:</h3>
							<p>
								Las solicitudes de ejercicio de derechos ARCO son gratuitas.
							</p>

							<h2>11. RETENCIÓN Y ELIMINACIÓN DE DATOS</h2>

							<h3>Período de retención:</h3>
							<p>
								Los datos se conservarán mientras el paciente mantenga una relación activa con la Fundación Nacer Para Vivir IPS.
							</p>

							<h3>Post-terminación de relación:</h3>
							<p>
								Después de que cese la relación paciente-institución, los datos se conservarán conforme a:
							</p>
							<ul>
								<li><strong>Obligaciones legales:</strong> Historias clínicas se conservan por 10 años (normas sanitarias colombianas).</li>
								<li><strong>Propósitos de auditoría y cumplimiento:</strong> 3 años adicionales si es necesario.</li>
								<li><strong>Requisitos tributarios y fiscales:</strong> Conforme a legislación colombiana.</li>
							</ul>

							<h3>Eliminación segura:</h3>
							<p>
								Transcurrido el período de retención, los datos serán eliminados de forma segura y definitiva, mediante destrucción física de medios o borrado criptográfico certificado.
							</p>

							<h2>12. CONSENTIMIENTO INFORMADO</h2>
							<p>
								Al usar la aplicación BORNIVE, el paciente da su consentimiento informado para:
							</p>
							<ul>
								<li>Recopilación de datos personales y datos de salud descritos en esta Política.</li>
								<li>Uso de geolocalización GPS para seguimiento clínico y visitas domiciliarias.</li>
								<li>Almacenamiento de datos en servidores de la Fundación en Colombia.</li>
								<li>Procesamiento de información clínica para estadísticas y análisis de riesgo.</li>
								<li>Compartición de datos solo en casos autorizados por ley o con consentimiento explícito adicional.</li>
							</ul>

							<h3>Consentimiento para menores:</h3>
							<p>
								Si el paciente es menor de 18 años, sus padres o representantes legales deben proporcionar consentimiento.
							</p>

							<h3>Retiro de consentimiento:</h3>
							<p>
								Puede retirar el consentimiento en cualquier momento sin afectar datos ya procesados, escribiendo a <strong>tecnologia@nacerparavivir.org</strong>
							</p>

							<h2>13. COOKIES Y TECNOLOGÍAS DE RASTREO</h2>
							<p>
								La aplicación BORNIVE utiliza:
							</p>
							<ul>
								<li><strong>Cookies de sesión:</strong> Para mantener la sesión autenticada del usuario.</li>
								<li><strong>Logs de aplicación:</strong> Para auditoría, seguridad y detección de problemas técnicos.</li>
							</ul>

							<h3>NO utilizamos:</h3>
							<p>Plataformas de analítica de terceros, publicidad dirigida, o rastreo de comportamiento externo.</p>

							<h2>14. MENORES DE EDAD</h2>
							<p>
								BORNIVE está diseñada para pacientes mayores de edad bajo nuestro plan bandera RCV. Si identifica que un menor está usando la aplicación:
							</p>
							<ul>
								<li>Los padres/tutores/Representantes Legales deben proporcionar consentimiento explícito.</li>
								<li>Solamente el representante legal puede ejercer derechos ARCO del menor.</li>
								<li>La Fundación puede suspender la cuenta si detecta uso no autorizado por menores.</li>
							</ul>

							<h2>15. CAMBIOS A ESTA POLÍTICA</h2>
							<p>
								La Fundación Nacer Para Vivir IPS se reserva el derecho de actualizar esta Política de Privacidad en cualquier momento para:
							</p>
							<ul>
								<li>Cumplir con cambios en la normativa colombiana.</li>
								<li>Mejorar medidas de seguridad.</li>
								<li>Incorporar nuevas funcionalidades en la aplicación.</li>
							</ul>
							<p>
								Cambios se notificarán a través de la aplicación o correo electrónico.
							</p>

							<h2>16. CONTACTO Y ATENCIÓN AL PACIENTE</h2>
							<p>
