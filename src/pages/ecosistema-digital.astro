---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import borniveIcon from '../assets/borniveicoo.png';
---

<BaseLayout title="Bornive - Ecosistema Digital" description="Bornive: Administrador de historial clínico para IPS">
	<Navbar dark={true} />

	<main class="main-content">
		<!-- Hero Section -->
		<section class="hero-section">
			<div class="container">
				<div class="hero-content">
					<div class="hero-text">
						<h1 class="hero-title">Bornive</h1>
						<p class="hero-description">
							Un administrador para la gestión del historial clínico de nuestros pacientes, solo accesible para el personal de la IPS.
						</p>
						<p class="hero-version">Versión 2.0.0</p>
					</div>
					<div class="hero-image-placeholder">
						<Image src={borniveIcon} alt="Bornive Logo" class="bornive-logo" width={200} format="webp" quality="mid" />
					</div>
				</div>
			</div>
			<div class="blob blob-1"></div>
			<div class="blob blob-2"></div>
		</section>

		<!-- Sections Navigation -->
		<section class="sections-section">
			<div class="container">
				<div class="tabs-container">
					<button class="tab-button active" data-tab="descargas">
						<span class="material-symbols-outlined">download</span>
						Descargas
					</button>
					<button class="tab-button" data-tab="documentacion">
						<span class="material-symbols-outlined">description</span>
						Documentación
					</button>
					<button class="tab-button" data-tab="privacidad">
						<span class="material-symbols-outlined">shield</span>
						Política de Privacidad
					</button>
					<button class="tab-button" data-tab="tutorial">
						<span class="material-symbols-outlined">play_circle</span>
						Tutorial
					</button>
				</div>

				<!-- Tab Contents -->
				<div class="tabs-content">
					<!-- DESCARGAS -->
					<div class="tab-panel active" id="descargas">
						<div class="downloads-grid">
							<!-- Windows Card -->
							<div class="platform-card">
								<div class="platform-header">
									<span class="material-symbols-outlined platform-icon">computer</span>
									<h3>Windows</h3>
								</div>
								<div class="platform-content">
									<div class="installer-type">
										<h4>User Installer</h4>
										<div class="download-links">
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>x64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>Arm64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
										</div>
									</div>
									<div class="installer-type">
										<h4>System Installer</h4>
										<div class="download-links">
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>x64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
											<a href="https://drive.google.com/file/d/1lSiswGhA_fDPMNwP9AKrjVgAepc8vj9A/view?pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>Arm64</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
										</div>
									</div>
								</div>
							</div>

							<!-- Mac Card -->
							<div class="platform-card">
								<div class="platform-header">
									<span class="material-symbols-outlined platform-icon">apple</span>
									<h3>macOS</h3>
								</div>
								<div class="platform-content">
									<div class="installer-type">
										<h4>Universal Installer</h4>
										<div class="download-links">
											<span class="download-link-pending">
												<span>.dmg Universal</span>
												<span style="opacity: 0.5;">Pendiente</span>
											</span>
										</div>
									</div>
								</div>
							</div>

							<!-- Android Card -->
							<div class="platform-card">
								<div class="platform-header">
									<span class="material-symbols-outlined platform-icon">android</span>
									<h3>Android</h3>
								</div>
								<div class="platform-content">
									<div class="installer-type">
										<h4>Google Play Store</h4>
										<div class="download-links">
											<a href="https://play.google.com/store/apps/details?id=com.fnpv.sistema&pli=1" target="_blank" rel="noopener noreferrer" class="download-link">
												<span>Android 10+</span>
												<span class="material-symbols-outlined">file_download</span>
											</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- DOCUMENTACIÓN -->
					<div class="tab-panel" id="documentacion">
						<div class="documentation-grid">
							<div class="doc-card">
								<div class="doc-header">
									<span class="material-symbols-outlined doc-icon">description</span>
									<h3>Guía de Instalación</h3>
								</div>
								<p class="doc-description">Instrucciones detalladas para instalar Bornive en tu dispositivo.</p>
								<a href="https://ejemplo.com/docs/instalacion" target="_blank" rel="noopener noreferrer" class="doc-link">
									Leer documentación
									<span class="material-symbols-outlined">arrow_forward</span>
								</a>
							</div>

							<div class="doc-card">
								<div class="doc-header">
									<span class="material-symbols-outlined doc-icon">settings</span>
									<h3>Configuración</h3>
								</div>
								<p class="doc-description">Aprende a configurar Bornive para tu entorno.</p>
								<a href="https://ejemplo.com/docs/configuracion" target="_blank" rel="noopener noreferrer" class="doc-link">
									Leer documentación
									<span class="material-symbols-outlined">arrow_forward</span>
								</a>
							</div>

							<div class="doc-card">
								<div class="doc-header">
									<span class="material-symbols-outlined doc-icon">support_agent</span>
									<h3>Manual de Usuario</h3>
								</div>
								<p class="doc-description">Guía completa de uso de la aplicación.</p>
								<a href="https://ejemplo.com/docs/usuario" target="_blank" rel="noopener noreferrer" class="doc-link">
									Leer documentación
									<span class="material-symbols-outlined">arrow_forward</span>
								</a>
							</div>
						</div>
					</div>

					<!-- POLÍTICA DE PRIVACIDAD -->
					<div class="tab-panel" id="privacidad">
						<div class="privacy-container">
							<div class="privacy-card">
								<h3>Política de Privacidad y Protección de Datos</h3>
								<p>
									En Bornive, la protección de tu información personal y los datos clínicos de nuestros pacientes es nuestra máxima prioridad.
									Cumplimos con todas las normativas de privacidad aplicables incluyendo HIPAA, GDPR y regulaciones locales colombianas.
								</p>
								<a href="https://ejemplo.com/privacy" target="_blank" rel="noopener noreferrer" class="privacy-link">
									Ver política completa
									<span class="material-symbols-outlined">open_in_new</span>
								</a>
							</div>

							<div class="privacy-card">
								<h3>Términos de Servicio</h3>
								<p>
									Los términos de servicio establecen los derechos y responsabilidades de todos los usuarios de Bornive.
									Asegúrate de revisar estos términos antes de usar la aplicación.
								</p>
								<a href="https://ejemplo.com/terms" target="_blank" rel="noopener noreferrer" class="privacy-link">
									Ver términos completos
									<span class="material-symbols-outlined">open_in_new</span>
								</a>
							</div>
						</div>
					</div>

					<!-- TUTORIAL -->
					<div class="tab-panel" id="tutorial">
						<div class="tutorial-container">
							<div class="video-card">
								<div class="video-container">
									<iframe
										width="560"
										height="315"
										src="https://www.youtube.com/embed/URTAmfyNIuM?si=cSNVsi6oxEGxwt7y"
										title="Video tutorial Bornive"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
										referrerpolicy="strict-origin-when-cross-origin"
										allowfullscreen>
									</iframe>
								</div>
								<h3>Tutorial Completo de Bornive</h3>
								<p>
									Aprende a usar Bornive desde cero. Este video tutorial te guiará a través de todas las características principales
									de la aplicación.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Info Section -->
		<section class="info-section">
			<div class="container">
				<div class="info-grid">
					<div class="info-card">
						<h3>Autores</h3>
						<p>Fundación Nacer Para Vivir y Contribuyentes</p>
					</div>
					<div class="info-card">
						<h3>Soporte Comercial y Consultoría</h3>
						<p>Nacer para Vivir TI</p>
					</div>
					<div class="info-card">
						<h3>Versión Actual</h3>
						<p>2.0.0</p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<style>
	.main-content {
		background-color: var(--color-surface);
		position: relative;
	}

	/* Hero Section */
	.hero-section {
		background: linear-gradient(135deg, #ffffff 0%, #f3f4f6 100%);
		padding: 6rem 0 4rem;
		position: relative;
		overflow: hidden;
		margin-top: 80px;
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-text {
		z-index: 10;
	}

	.hero-title {
		font-size: 3.5rem;
		color: var(--color-brand-dark);
		margin-bottom: 1.5rem;
		line-height: 1.2;
	}

	.hero-description {
		font-size: 1.2rem;
		color: var(--color-on-surface);
		margin-bottom: 2rem;
		line-height: 1.6;
		font-family: var(--font-body);
	}

	.hero-version {
		font-size: 0.95rem;
		color: var(--color-primary);
		font-weight: 600;
		font-family: var(--font-headline);
		letter-spacing: 0.05em;
	}

	.hero-image-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--color-primary), #1ea952);
		border-radius: 2.5rem;
		aspect-ratio: 1;
		position: relative;
		z-index: 10;
		box-shadow: 0 20px 40px rgba(37, 211, 102, 0.3);
	}

	.icon-large {
		font-size: 6rem;
		color: white;
		font-variation-settings: 'FILL' 1, 'wght' 700;
	}

	.bornive-logo {
		width: 100%;
		height: auto;
		max-width: 200px;
		object-fit: contain;
	}

	/* Decorative Blobs */
	.blob {
		position: absolute;
		border-radius: 50%;
		opacity: 0.15;
		pointer-events: none;
	}

	.blob-1 {
		width: 400px;
		height: 400px;
		background: var(--color-primary);
		top: -100px;
		right: -100px;
	}

	.blob-2 {
		width: 350px;
		height: 350px;
		background: var(--color-brand-dark);
		bottom: -80px;
		left: -100px;
	}

	/* Sections */
	.sections-section {
		background-color: var(--color-surface);
		padding: 4rem 0;
		position: relative;
	}

	/* Tabs Navigation */
	.tabs-container {
		display: flex;
		gap: 1rem;
		margin-bottom: 3rem;
		border-bottom: 2px solid var(--color-surface-container-low);
		overflow-x: auto;
		padding-bottom: 1rem;
	}

	.tab-button {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.8rem 1.5rem;
		background: none;
		border: none;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		position: relative;
		transition: all 0.3s ease;
		white-space: nowrap;
		font-family: var(--font-headline);
		text-transform: uppercase;
		letter-spacing: -0.01em;
	}

	.tab-button .material-symbols-outlined {
		font-size: 1.3rem;
	}

	.tab-button:hover {
		color: var(--color-brand-dark);
		transform: translateY(-2px);
	}

	.tab-button.active {
		color: var(--color-brand-dark);
	}

	.tab-button.active::after {
		content: '';
		position: absolute;
		bottom: -1rem;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-brand-dark));
		border-radius: 2px;
	}

	/* Tab Content */
	.tabs-content {
		position: relative;
	}

	.tab-panel {
		display: none;
		animation: fadeIn 0.3s ease;
	}

	.tab-panel.active {
		display: block;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Downloads Grid */
	.downloads-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2rem;
	}

	.platform-card {
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		border-radius: 2.5rem;
		padding: 2rem;
		transition: all 0.3s ease;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
	}

	.platform-card:hover {
		box-shadow: 0 15px 20px -5px rgba(37, 211, 102, 0.1);
		transform: translateY(-4px);
		border-color: rgba(37, 211, 102, 0.3);
	}

	.platform-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.platform-icon {
		font-size: 2.5rem;
		color: var(--color-primary);
		flex-shrink: 0;
		font-variation-settings: 'FILL' 1, 'wght' 700;
	}

	.platform-header h3 {
		font-size: 1.5rem;
		color: var(--color-brand-dark);
		margin: 0;
	}

	.platform-content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.installer-type h4 {
		font-size: 0.95rem;
		color: var(--color-on-surface);
		margin-bottom: 0.75rem;
		text-transform: none;
		font-weight: 600;
		letter-spacing: normal;
	}

	.download-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.download-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		background: var(--color-surface-container-low);
		border-radius: 0.75rem;
		text-decoration: none;
		color: var(--color-brand-dark);
		transition: all 0.3s ease;
		border: 1px solid transparent;
		font-size: 0.95rem;
		font-weight: 500;
	}

	.download-link:hover {
		background: var(--color-primary);
		color: white;
		border-color: var(--color-primary);
		transform: translateX(4px);
	}

	.download-link .material-symbols-outlined {
		font-size: 1.2rem;
		flex-shrink: 0;
	}

	.download-link-pending {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		background: var(--color-surface-container-low);
		border-radius: 0.75rem;
		text-decoration: none;
		color: var(--color-on-surface-variant);
		font-size: 0.95rem;
		font-weight: 500;
		cursor: not-allowed;
		opacity: 0.6;
		border: 1px solid var(--color-outline-variant);
	}

	/* Documentation Grid */
	.documentation-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.doc-card {
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		border-radius: 2.5rem;
		padding: 2rem;
		transition: all 0.3s ease;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.doc-card:hover {
		box-shadow: 0 15px 20px -5px rgba(37, 211, 102, 0.1);
		transform: translateY(-4px);
		border-color: rgba(37, 211, 102, 0.3);
	}

	.doc-header {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.doc-icon {
		font-size: 2rem;
		color: var(--color-primary);
		flex-shrink: 0;
		font-variation-settings: 'FILL' 1, 'wght' 700;
	}

	.doc-header h3 {
		font-size: 1.2rem;
		color: var(--color-brand-dark);
		margin: 0;
	}

	.doc-description {
		color: var(--color-on-surface);
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0;
	}

	.doc-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
		align-self: flex-start;
	}

	.doc-link:hover {
		color: var(--color-brand-dark);
		transform: translateX(4px);
	}

	.doc-link .material-symbols-outlined {
		font-size: 1.2rem;
	}

	/* Privacy Section */
	.privacy-container {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
	}

	.privacy-card {
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		border-radius: 2.5rem;
		padding: 2rem;
		transition: all 0.3s ease;
	}

	.privacy-card:hover {
		box-shadow: 0 15px 20px -5px rgba(37, 211, 102, 0.1);
		transform: translateY(-4px);
		border-color: rgba(37, 211, 102, 0.3);
	}

	.privacy-card h3 {
		font-size: 1.3rem;
		color: var(--color-brand-dark);
		margin-bottom: 1rem;
	}

	.privacy-card p {
		color: var(--color-on-surface);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.privacy-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
	}

	.privacy-link:hover {
		color: var(--color-brand-dark);
		transform: translateX(4px);
	}

	.privacy-link .material-symbols-outlined {
		font-size: 1.1rem;
	}

	/* Tutorial Section */
	.tutorial-container {
		display: flex;
		justify-content: center;
	}

	.video-card {
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-outline-variant);
		border-radius: 2.5rem;
		padding: 2rem;
		max-width: 600px;
		width: 100%;
		transition: all 0.3s ease;
		text-align: center;
	}

	.video-card:hover {
		box-shadow: 0 15px 20px -5px rgba(37, 211, 102, 0.1);
		transform: translateY(-4px);
		border-color: rgba(37, 211, 102, 0.3);
	}

	.video-container {
		position: relative;
		width: 100%;
		padding-bottom: 56.25%;
		height: 0;
		overflow: hidden;
		border-radius: 1.5rem;
		margin-bottom: 1.5rem;
		background: linear-gradient(135deg, var(--color-primary), #1ea952);
	}

	.video-container iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 1.5rem;
		border: none;
	}

	.video-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--color-primary), #1ea952);
		border-radius: 1.5rem;
		aspect-ratio: 16/9;
		margin-bottom: 1.5rem;
		transition: all 0.3s ease;
	}

	.video-card:hover .video-placeholder,
	.video-card:hover .video-container {
		transform: scale(1.02);
	}

	.play-icon {
		font-size: 4rem;
		color: white;
		font-variation-settings: 'FILL' 1, 'wght' 700;
	}

	.video-card h3 {
		font-size: 1.5rem;
		color: var(--color-brand-dark);
		margin-bottom: 1rem;
	}

	.video-card p {
		color: var(--color-on-surface);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.tutorial-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, var(--color-primary), #1ea952);
		color: white;
		padding: 0.9rem 2rem;
		border-radius: 1rem;
